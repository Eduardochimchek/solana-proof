# PostgreSQL connection strings (Neon recommended: https://neon.tech).
# DATABASE_URL: pooled connection, used by the application at runtime.
# DATABASE_URL_UNPOOLED: direct connection, used by Prisma Migrate.
# Both are provided automatically when you connect a Neon database via the
# Vercel "Storage" tab; run `npx vercel env pull .env` to fetch them locally.
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""

# Solana Devnet RPC endpoint.
# Leave empty to use the public cluster endpoint (https://api.devnet.solana.com).
# For higher reliability, use a dedicated provider such as Helius or QuickNode.
NEXT_PUBLIC_SOLANA_RPC_URL=""

# Public base URL of the deployed app, used for SEO metadata and OpenGraph tags.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
